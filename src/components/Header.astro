---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Books', href: '/books' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-navy text-cream py-4 px-6">
  <nav class="max-w-5xl mx-auto flex items-center justify-between">
    <a href="/" class="font-serif text-xl tracking-wide hover:text-burgundy transition-colors">
      Scott A. Lund
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex gap-8 text-sm tracking-widest uppercase">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`hover:text-burgundy transition-colors ${
              currentPath === link.href ? 'text-burgundy' : 'text-cream'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile nav (simple stacked, no JS required) -->
    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer text-cream hover:text-burgundy transition-colors">
        <span class="sr-only">Menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <ul class="absolute right-0 top-8 bg-navy border border-navy-light rounded shadow-lg py-2 min-w-40 z-50">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class={`block px-5 py-2 text-sm tracking-widest uppercase hover:text-burgundy transition-colors ${
                currentPath === link.href ? 'text-burgundy' : 'text-cream'
              }`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
