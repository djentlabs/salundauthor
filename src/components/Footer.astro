---
import { socialLinks } from '../data/socialLinks.js';
---

<footer class="bg-navy text-cream mt-auto">
  <div class="max-w-5xl mx-auto px-6 py-10 flex flex-col items-center gap-6">
    <p class="font-serif text-lg tracking-wide">Scott A. Lund</p>

    <ul class="flex gap-5">
      {socialLinks.map(link => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="text-cream/60 hover:text-burgundy transition-colors"
            set:html={link.icon}
          />
        </li>
      ))}
    </ul>

    <p class="text-xs text-cream/50 tracking-wide">
      &copy; {new Date().getFullYear()} Scott A. Lund. All rights reserved.
    </p>
  </div>
</footer>
