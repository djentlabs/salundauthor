---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Books"
  description="Explore the Land of Boondoggle by Scott A. Lund — a YA fantasy novel set in a world forty years in the making."
>

  <!-- Page Header -->
  <section class="bg-navy text-cream px-6 py-16 md:py-20 text-center">
    <p class="text-cream-dark tracking-widest uppercase text-xs mb-4">The Series</p>
    <h1 class="font-serif text-4xl md:text-5xl">The Land of Boondoggle</h1>
    <p class="font-sans text-cream/60 mt-4 text-sm tracking-wide">by Scott A. Lund</p>
  </section>


  <!-- Books Grid -->
  <section class="bg-cream px-6 py-20 md:py-28">
    <div class="max-w-md mx-auto flex justify-center">

      <!-- Book One -->
      <div class="flex flex-col items-center text-center gap-6">
        <a href="/books/the-land-of-boondoggle" class="group">
          <img
            src="/images/book-one-cover.png"
            alt="Title Coming Soon — Book One cover"
            class="w-48 md:w-56 shadow-xl rounded-sm transition-transform group-hover:-translate-y-1"
          />
        </a>
        <div>
          <p class="text-burgundy tracking-widest uppercase text-xs mb-2">Book One</p>
          <h2 class="font-serif text-2xl md:text-3xl text-navy mb-3">
            Title Coming Soon
          </h2>
          <p class="text-navy/60 text-sm mb-6">Releasing late Q4 2026</p>
          <a
            href="/books/the-land-of-boondoggle"
            class="inline-block bg-burgundy hover:bg-burgundy-light text-cream font-sans font-bold tracking-widest uppercase text-xs px-8 py-3 transition-colors"
          >
            Learn More
          </a>
        </div>
      </div>

    </div>
  </section>


  <!-- Series note -->
  <section class="bg-cream-dark px-6 py-16 md:py-20 text-center">
    <div class="max-w-xl mx-auto">
      <p class="font-serif italic text-navy text-xl leading-relaxed">
        "Let's see what was happening in the Land of Boondoggle…"
      </p>
      <p class="text-navy/50 text-sm mt-4">— Scott A. Lund</p>
    </div>
  </section>

</Layout>
